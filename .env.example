# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (COPY TO .env)
# ==============================================================================

# Core Application
NODE_ENV=production
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
REFRESH_TOKEN_SECRET=super_secret_refresh_key_at_least_32_characters_long

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres_secure_pass@localhost:5432/media_platform?schema=public

# Redis & Queues
REDIS_URL=redis://localhost:6379

# Storage Engine Configuration
# 8 GiB Logical Bucket Quota (8,589,934,592 bytes)
STORAGE_LOGICAL_QUOTA_BYTES=8589934592
# 256 MiB Chunk Size (268,435,456 bytes)
STORAGE_CHUNK_SIZE_BYTES=268435456

# Cloudflare R2 Account 1 (Primary - Authorized)
R2_ACC1_DISPLAY_NAME=Cloudflare Account Alpha (US-East)
R2_ACC1_ACCOUNT_ID=replace_with_cloudflare_account_id_1
R2_ACC1_ENDPOINT=https://replace_with_cloudflare_account_id_1.r2.cloudflarestorage.com
R2_ACC1_ACCESS_KEY_ID=replace_with_r2_access_key_id_1
R2_ACC1_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key_1
R2_ACC1_BUDGET_USD=50.00

# Cloudflare R2 Account 2 (Secondary / Spillover - Authorized)
R2_ACC2_DISPLAY_NAME=Cloudflare Account Beta (EU-West)
R2_ACC2_ACCOUNT_ID=replace_with_cloudflare_account_id_2
R2_ACC2_ENDPOINT=https://replace_with_cloudflare_account_id_2.r2.cloudflarestorage.com
R2_ACC2_ACCESS_KEY_ID=replace_with_r2_access_key_id_2
R2_ACC2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key_2
R2_ACC2_BUDGET_USD=50.00
