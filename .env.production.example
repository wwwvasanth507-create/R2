# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.production on the production host:
#    cp .env.production.example .env.production
# 2. Generate cryptographically strong random secrets for JWT and database.
# 3. Enter your authorized Cloudflare R2 Account IDs, Access Keys, and Secrets.
# 4. Never commit real production secrets to version control.
# ==============================================================================

# Core Runtime
NODE_ENV=production
PORT=4000
API_URL=https://api.yourdomain.com
WEB_URL=https://yourdomain.com
ADMIN_URL=https://admin.yourdomain.com

# Cryptographic Authentication Secrets (Min 64 random characters)
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_64_CHAR_CRYPTOGRAPHICALLY_SECURE_JWT_SECRET_STRING
REFRESH_TOKEN_SECRET=REPLACE_WITH_A_64_CHAR_CRYPTOGRAPHICALLY_SECURE_REFRESH_SECRET_STRING

# PostgreSQL Production Credentials (Internal Network)
POSTGRES_USER=media_prod_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_POSTGRES_PASSWORD
POSTGRES_DB=media_platform_prod
DATABASE_URL=postgresql://media_prod_user:REPLACE_WITH_STRONG_RANDOM_POSTGRES_PASSWORD@postgres:5432/media_platform_prod?schema=public

# Redis Production Credentials (Internal Network)
REDIS_PASSWORD=REPLACE_WITH_STRONG_RANDOM_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_RANDOM_REDIS_PASSWORD@redis:6379

# Storage Engine Configuration
# Application-Enforced 8 GiB Logical Quota per Bucket (8,589,934,592 bytes)
STORAGE_LOGICAL_QUOTA_BYTES=8589934592
# 256 MiB Chunk Sizing (268,435,456 bytes)
STORAGE_CHUNK_SIZE_BYTES=268435456

# Cloudflare R2 Account 1 (Primary Authorized Production Account)
R2_ACC1_DISPLAY_NAME=Cloudflare Production Account Alpha
R2_ACC1_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID_ALPHA
R2_ACC1_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID_ALPHA.r2.cloudflarestorage.com
R2_ACC1_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID_ALPHA
R2_ACC1_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY_ALPHA
R2_ACC1_BUDGET_USD=100.00

# Cloudflare R2 Account 2 (Secondary Spillover Authorized Account)
R2_ACC2_DISPLAY_NAME=Cloudflare Production Account Beta
R2_ACC2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID_BETA
R2_ACC2_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID_BETA.r2.cloudflarestorage.com
R2_ACC2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID_BETA
R2_ACC2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY_BETA
R2_ACC2_BUDGET_USD=100.00

# Transactional Email & Alert Notifications
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=YOUR_SMTP_PASSWORD
ALERT_RECIPIENT_EMAIL=ops@yourdomain.com
EMAIL_FROM="Media Platform Notifications" <notifications@yourdomain.com>

# Monitoring & OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://prometheus:9090
