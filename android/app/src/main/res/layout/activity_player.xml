<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_dark">

    <!-- Video Player Container (Aspect ratio 16:9 in portrait, match_parent in fullscreen) -->
    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#000000"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:surface_type="texture_view"
            app:show_buffering="when_playing"
            app:use_controller="true" />

        <!-- 24K Cinema Vivid Overlay Filter Layer -->
        <View
            android:id="@+id/vivid_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#05000000"
            android:visibility="gone" />

        <!-- Overlay Top Controls (Back button, Title, Active Badges) -->
        <LinearLayout
            android:id="@+id/player_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="#66000000">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_arrow_back"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/player_overlay_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Video Title" />

            <!-- Active Status Badges -->
            <TextView
                android:id="@+id/badge_active_24k"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ 24K"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="10sp"
                android:background="@drawable/bg_badge_24k"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/badge_active_dolby"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎧 DOLBY"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="10sp"
                android:background="@drawable/bg_badge_dolby"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/player_loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent_red"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Scrollable Content Below Player (Hidden in Fullscreen) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/details_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/player_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tv_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp"
                tools:text="Tamil Cinematic Beats &amp; Acoustic Sessions 2026 (Official WaveMusic Live)" />

            <!-- Metadata Row (Views, Time, 24K Badge) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tv_detail_meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    tools:text="1.4M views • 2026 • 45:30" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24K ULTRA HD"
                    android:textColor="@color/badge_24k"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_24k"
                    android:backgroundTint="#332A00"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DOLBY 3D"
                    android:textColor="@color/badge_dolby"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_dolby"
                    android:backgroundTint="#102A45"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <!-- Enhancements Action Buttons Bar (24K Vivid Mode, Dolby EQ, Playback Speed) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Toggle 24K Cinema Vivid -->
                    <LinearLayout
                        android:id="@+id/btn_toggle_24k"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:background="@drawable/bg_pill_toggle_off"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/icon_24k_sparkle"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_sparkles"
                            app:tint="@color/text_gray" />

                        <TextView
                            android:id="@+id/tv_24k_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="24K Vivid Mode"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Toggle Dolby Bass & Audio EQ -->
                    <LinearLayout
                        android:id="@+id/btn_toggle_dolby"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_toggle_off"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/icon_dolby_eq"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_headphones"
                            app:tint="@color/text_gray" />

                        <TextView
                            android:id="@+id/tv_dolby_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Dolby Bass EQ"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Speed Selector Button -->
                    <LinearLayout
                        android:id="@+id/btn_playback_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_toggle_off"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tv_speed_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡ 1.0x Speed"
                            android:textColor="@color/text_white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Social / Quick Actions Row (Like, Watchlist, Share) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <!-- Like -->
                <LinearLayout
                    android:id="@+id/btn_action_like"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/iv_like_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_heart"
                        app:tint="@color/text_white" />

                    <TextView
                        android:id="@+id/tv_like_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Like"
                        android:textColor="@color/text_gray"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- My List -->
                <LinearLayout
                    android:id="@+id/btn_action_watchlist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/iv_watchlist_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_bookmark"
                        app:tint="@color/text_white" />

                    <TextView
                        android:id="@+id/tv_watchlist_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="My List"
                        android:textColor="@color/text_gray"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Share -->
                <LinearLayout
                    android:id="@+id/btn_action_share"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_share"
                        app:tint="@color/text_white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Share"
                        android:textColor="@color/text_gray"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <!-- Channel Profile Info Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_channel_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/bg_pill_toggle_off"
                    android:contentDescription="Channel" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_channel_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="WaveMusic Originals" />

                    <TextView
                        android:id="@+id/tv_subscriber_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        tools:text="1.2M subscribers" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_subscribe"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Subscribe"
                    android:textAllCaps="false"
                    android:textColor="@color/text_white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/accent_red"
                    app:cornerRadius="18dp" />
            </LinearLayout>

            <!-- Video Description Section -->
            <TextView
                android:id="@+id/tv_detail_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/text_gray"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                tools:text="Experience high bitrate cinema-grade master quality streaming on VD Player. Encoded with adaptive byte slices and multi-bucket zero-latency routing." />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <!-- Up Next / Related Videos Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="More Like This"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Related Videos RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_related_videos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
