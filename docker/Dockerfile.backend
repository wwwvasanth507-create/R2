FROM node:20-alpine AS builder

WORKDIR /app

# Copy root configuration and workspaces
COPY package*.json ./
COPY packages/common/package*.json ./packages/common/
COPY packages/storage-engine/package*.json ./packages/storage-engine/
COPY apps/backend/package*.json ./apps/backend/

RUN npm install

COPY packages/common ./packages/common
COPY packages/storage-engine ./packages/storage-engine
COPY apps/backend ./apps/backend

RUN npm run build -w packages/common
RUN npm run build -w packages/storage-engine
RUN npm run build -w apps/backend

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app ./

EXPOSE 4000
CMD ["npm", "run", "start", "-w", "apps/backend"]
